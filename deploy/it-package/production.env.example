# Euro Assist Providers V2 - production/staging environment template.
# Copy to providers/.env ON THE SERVER ONLY, fill the <...> values, and never e-mail, commit or zip the result.
# Every value below that is not <...> is the required setting; do not loosen it.

APP_NAME="Euro Assist Providers"
APP_ENV=production
# Generate ONCE on the server: php artisan key:generate --force   (keep a private backup of the value)
APP_KEY=
# MUST be false in production (the application refuses to start otherwise).
APP_DEBUG=false
# The exact public HTTPS address. The app answers ONLY to this host name (https:// is mandatory).
APP_URL=https://<host name, e.g. providers-v2.euro-assist.com>
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Dedicated database and least-privilege user created for V2 only (never root, never the legacy DB).
DB_CONNECTION=mysql
DB_HOST=<database host, often 127.0.0.1 or localhost>
DB_PORT=3306
DB_DATABASE=<new empty database, e.g. euro_assist_providers_v2>
DB_USERNAME=<v2 database user>
DB_PASSWORD=<v2 database password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Comma-separated reverse-proxy IP addresses in front of PHP (Plesk nginx/IIS ARR). Ask the host.
# "*" is refused in production. Empty = no proxy trusted (rate limits and audit then see the proxy IP).
TRUSTED_PROXIES=<proxy IP list, e.g. 127.0.0.1>

# Public read access to the API stays OFF until the owner approves the consumers (decision D7).
PROVIDERS_API_PUBLIC_READ=false

# Import limits validated locally; keep until staging confirms worker time limits.
IMPORTS_MAX_FILE_BYTES=10485760
IMPORTS_MAX_ROWS=20000

# Password-reset e-mails. Leave "log" until the company SMTP account is provided.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="<no-reply address>"
MAIL_FROM_NAME="Euro Assist Providers"

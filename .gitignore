# Python governance tests and ephemeral reports
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
test-results/
*.test-output

# Private raw inputs and generated exports. Anchored to data locations so that
# application source such as app/Exports/ or app/Models/Uploads/ stays trackable;
# scripts/check_repo_hygiene.py blocks data files in same-named nested folders.
/private-data/
/private_data/
/backups/
/dumps/
/exports/
/uploads/
/public/uploads/
/storage/**/exports/
/storage/**/uploads/
/storage/**/backups/

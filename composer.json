{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "euro-assist/providers-v2",
    "type": "project",
    "description": "Euro Assist Providers V2: private provider-directory administration application.",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-xml": "*",
        "ext-zip": "*",
        "laravel/framework": "^13.17",
        "livewire/livewire": "^4.4",
        "openspout/openspout": "^5.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.27",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test": "@php vendor/phpunit/phpunit/phpunit",
        "format": "@php vendor/laravel/pint/builds/pint",
        "format:check": "@php vendor/laravel/pint/builds/pint --test",
        "analyse": "@php vendor/phpstan/phpstan/phpstan analyse --memory-limit=512M",
        "check": [
            "@composer validate --strict",
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
